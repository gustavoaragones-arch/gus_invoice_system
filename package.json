{
  "name": "gus-invoice-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canadian Private Billing System — application foundation and persistence layer (Phase 3).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "decimal.js": "10.4.3",
    "googleapis": "^144.0.0",
    "jose": "5.9.6",
    "next": "16.3.5",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "embedded-postgres": "17.0.0-beta.13",
    "prisma": "5.20.0",
    "tsx": "4.23.13",
    "typescript": "5.6.3",
    "uuid": "14.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
