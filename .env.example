# Copy to .env for local development. Never commit real secrets (SEC-SECRETS-001).

# PostgreSQL / Supabase connection string.
# In production this points at the provisioned Supabase Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gus_invoice_system?schema=public"

# Direct (non-pooled) connection, used by Prisma Migrate. Supabase provides a
# separate direct connection string distinct from the pooled one.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gus_invoice_system?schema=public"

# Supabase Auth — used to verify session JWTs server-side (SEC-AUTH-002).
# The JWT secret is used to verify tokens issued by Supabase Auth without
# a network round-trip. Never expose this value to the client.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_JWT_SECRET="replace-with-supabase-project-jwt-secret"

# Symmetric key used to encrypt OAuth tokens (Calendar) at rest (SEC-OAUTH-001).
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
