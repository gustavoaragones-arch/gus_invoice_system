# Never commit real secrets (SEC-SECRETS-001). Copy to .env for local development.
# In production, set these in the hosting platform's secret store, not in a file.
#
# ─── REQUIRED IN PRODUCTION ─────────────────────────────────────────────
# The server refuses to start in production (NODE_ENV=production) if any of
# these is missing/invalid, or if a provider below is left on "development".
# Values marked (server-only) must NEVER be given a NEXT_PUBLIC_ prefix.

# Authentication provider. Must be exactly "supabase" in production.
AUTH_PROVIDER="development"

# PostgreSQL / Supabase. DATABASE_URL must connect as a NON-superuser,
# non-table-owner role (see prisma/migrations/*_app_runtime_role) so that
# Row-Level Security applies. (server-only)
DATABASE_URL="postgresql://app_runtime:app_runtime_local_dev_only@localhost:5432/gus_invoice_system?schema=public"
# Owner/admin connection used only by `prisma migrate` (server-only)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gus_invoice_system?schema=public"

# Supabase Auth (the production identity provider). Session tokens are verified
# with the project's public signing keys (ES256) fetched from
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json — no shared secret is used.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# API key sent by the server to Supabase Auth when signing users in. This may
# be the project's PUBLISHABLE key. Never place a service-role/secret key here.
# (server-only)
SUPABASE_ANON_KEY="replace-with-supabase-publishable-key"

# Dedicated secret signing the Google OAuth `state` parameter. At least 32
# characters, used for nothing else, never reused from another variable.
# Generate with: openssl rand -base64 48 (server-only, secret)
GOOGLE_OAUTH_STATE_SECRET="replace-with-dedicated-32+-character-secret"

# 32-byte base64 key encrypting Calendar OAuth tokens at rest.
# Generate with: openssl rand -base64 32 (server-only, secret)
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Public https:// base URL of the application (not secret; client-visible by design).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Calendar provider. Must be exactly "google" in production.
CALENDAR_PROVIDER="development"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/calendar/oauth/callback"

# Email provider. Must be exactly "smtp" in production.
EMAIL_PROVIDER="development"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="billing@example.com"
EMAIL_FROM_NAME="Your Business Name"

# ─── DEVELOPMENT / TEST ONLY ────────────────────────────────────────────
# AUTH_PROVIDER=development enables email-only sign-in (no password) and
# locally-minted HS256 session tokens signed with SUPABASE_JWT_SECRET, which is
# used ONLY by this development path (not needed, and not read, in production).
# SUPABASE_JWT_SECRET="any-local-development-string"
# EMAIL_PROVIDER=development / CALENDAR_PROVIDER=development use in-process
# fakes. All three are rejected when NODE_ENV=production.
