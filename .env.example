# Copy to .env for local development. Never commit real secrets (SEC-SECRETS-001).

# PostgreSQL / Supabase connection string.
# In production this points at the provisioned Supabase Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gus_invoice_system?schema=public"

# Direct (non-pooled) connection, used by Prisma Migrate. Supabase provides a
# separate direct connection string distinct from the pooled one.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gus_invoice_system?schema=public"

# Supabase Auth — used to verify session JWTs server-side (SEC-AUTH-002).
# The JWT secret is used to verify tokens issued by Supabase Auth without
# a network round-trip. Never expose this value to the client.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_JWT_SECRET="replace-with-supabase-project-jwt-secret"

# Calendar provider. Use "development" for local/test (no real Google API calls).
# Use "google" for production Google Calendar integration.
CALENDAR_PROVIDER="development"

# Google Calendar OAuth (required when CALENDAR_PROVIDER=google).
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/calendar/oauth/callback"

# Public application URL used for OAuth redirects in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email delivery provider. Use "development" for local/test (no real mailbox delivery).
# Use "smtp" for production SMTP delivery with PDF attachments.
EMAIL_PROVIDER="development"

# SMTP email delivery (required when EMAIL_PROVIDER=smtp).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="billing@example.com"
EMAIL_FROM_NAME="Your Business Name"

# Symmetric key used to encrypt OAuth tokens (Calendar) at rest (SEC-OAUTH-001).
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
